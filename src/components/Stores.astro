---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, goPlanet } from '../data/site';
import mittyLogo from '../assets/brand/mitty.svg?raw';
---

<section class="stores dark section" aria-labelledby="stores-title">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow" data-fade>The family</p>
        <h2 id="stores-title" class="display h2" data-split>One family.<br /><span class="serif">More to come.</span></h2>
      </div>
      <p class="lead muted" data-fade>
        Brand Mark is part of a family of stores that has been dressing Berhampur since {site.familySince}. Visit either store, shop our labels online, and watch this space.
      </p>
    </div>

    <ul class="stores__grid" data-stagger>
      <li class="store store--here">
        <span class="store__tag">You are here</span>
        <div class="store__logo store__logo--bm"><Logo tone="ink" /></div>
        <p class="store__line">Premium brands, the sneaker wall, perfumes and our own MITTY.</p>
        <p class="store__addr"><Icon name="pin" /> {site.address.line1}, {site.city}</p>
        <div class="store__links">
          <a href={site.mapsLink} target="_blank" rel="noopener" class="link">Directions <Icon name="arrow-up" /></a>
          <a href={site.phoneHref} class="link">{site.phone}</a>
        </div>
      </li>

      <li class="store">
        <span class="store__tag">Since {goPlanet.since}</span>
        <div class="store__logo"><img src="/logos/goplanet-color.png" alt="Go Planet" class="store__gp" width="500" height="500" loading="lazy" /></div>
        <p class="store__line">Where the Brand Mark story began. Fashion for men and women, ethnic wear, footwear and fragrances, plus Brand Mark Luxe online.</p>
        <p class="store__addr"><Icon name="pin" /> {goPlanet.address}</p>
        <div class="store__links">
          <a href={goPlanet.url} target="_blank" rel="noopener" class="link">{goPlanet.urlLabel} <Icon name="arrow-up" /></a>
          <a href={goPlanet.mapsLink} target="_blank" rel="noopener" class="link">Directions <Icon name="arrow-up" /></a>
        </div>
      </li>

      <li class="store">
        <span class="store__tag">Our label</span>
        <div class="store__logo store__logo--mitty" set:html={mittyLogo} role="img" aria-label="MITTY" />
        <p class="store__line">Our in-house menswear label. Sharp shirts and trousers, made for everyday confidence.</p>
        <p class="store__addr"><Icon name="pin" /> In store at Brand Mark & Go Planet</p>
        <div class="store__links">
          <a href="/mitty" class="link">Discover MITTY <Icon name="arrow" /></a>
          <a href="https://mitty.co.in" target="_blank" rel="noopener" class="link">mitty.co.in <Icon name="arrow-up" /></a>
        </div>
      </li>

      <li class="store store--soon">
        <span class="store__tag store__tag--soon"><i></i> Coming soon</span>
        <p class="store__soon display">New<br />location</p>
        <p class="store__line">We're growing. A new location is on its way. Same brands, same care, new address.</p>
        <div class="store__links">
          <a href={site.instagram} target="_blank" rel="noopener" class="link"><Icon name="instagram" /> Follow for the reveal</a>
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  .stores .sec-head .eyebrow {
    color: var(--amber);
    margin-bottom: 18px;
  }
  .stores__grid {
    display: grid;
    gap: 14px;
  }
  @media (min-width: 700px) {
    .stores__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1200px) {
    .stores__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .store {
    position: relative;
    display: grid;
    grid-template-rows: auto 120px 1fr auto auto;
    gap: 16px;
    padding: 26px;
    min-height: 420px;
    background: var(--ink-2);
    box-shadow: inset 0 0 0 1px var(--line-d);
    transition: background 0.5s var(--ease), transform 0.6s var(--ease);
  }
  .store:hover {
    background: var(--ink-3);
    transform: translateY(-6px);
  }
  .store--here {
    background: var(--paper);
    color: var(--ink);
    box-shadow: none;
  }
  .store--here:hover {
    background: #fff;
  }
  .store__tag {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 99px;
    font-size: var(--fs-micro);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    box-shadow: inset 0 0 0 1px currentColor;
    opacity: 0.85;
  }
  .store__tag--soon {
    color: var(--amber);
    opacity: 1;
  }
  .store__tag--soon i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--amber);
    animation: soon 1.6s ease-in-out infinite;
  }
  @keyframes soon {
    50% {
      opacity: 0.2;
    }
  }
  .store__logo {
    display: flex;
    align-items: center;
  }
  .store__logo--bm {
    width: 190px;
  }
  .store__logo--mitty {
    width: 96px;
    color: var(--paper);
  }
  .store__logo--mitty :global(svg) {
    width: 100%;
    height: auto;
  }
  .store__gp {
    width: 150px;
    height: auto;
    margin: -24px 0 -24px -18px;
  }
  .store__line {
    font-size: 0.95rem;
    opacity: 0.8;
  }
  .store__addr {
    display: flex;
    gap: 8px;
    font-size: var(--fs-small);
    opacity: 0.75;
  }
  .store__addr :global(svg) {
    flex: none;
    width: 15px;
    height: 15px;
    margin-top: 2px;
  }
  .store__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
  }
  .store__links .link {
    font-size: var(--fs-micro);
  }
  .store--soon {
    background: transparent;
    box-shadow: inset 0 0 0 1px rgba(240, 168, 60, 0.45);
    grid-template-rows: auto 120px 1fr auto;
  }
  .store--soon:hover {
    background: rgba(240, 168, 60, 0.06);
  }
  .store__soon {
    align-self: center;
    font-size: clamp(2.2rem, 3vw, 2.8rem);
    line-height: 0.95;
    color: var(--amber);
  }
</style>
