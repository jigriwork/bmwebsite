---
/**
 * The Brand Mark logo. The tagline is white by default for dark backgrounds;
 * pass tone="ink" on light backgrounds so FASHION & FOOTWEAR stays visible.
 */
interface Props {
  class?: string;
  label?: string;
  tone?: 'light' | 'ink';
}

const { class: cls, label = 'Brand Mark', tone = 'light' } = Astro.props;
const logoSrc = tone === 'ink' ? '/brand/brandmark-logo-ink.png' : '/brand/brandmark-logo.png';
---

<img class:list={['bm-logo', cls]} src={logoSrc} alt={label} width="474" height="173" />

<style>
  .bm-logo {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    object-fit: contain;
    background: transparent;
  }
</style>
