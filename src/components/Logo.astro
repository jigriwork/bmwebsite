---
interface Props {
  class?: string;
  label?: string;
}

const { class: cls, label = 'Brand Mark' } = Astro.props;
const logoSrc = '/brand/Brand%20Mark%20logo_20261002_223741_0000.png';
---

<img class:list={['bm-logo', cls]} src={logoSrc} alt={label} />

<style>
  .bm-logo {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    object-fit: contain;
    background: transparent;
  }
</style>
