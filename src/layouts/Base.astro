---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import Curtain from '../components/Curtain.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description = site.description, image = '/og.jpg' } = Astro.props;
const fullTitle = title ? `${title} | Brand Mark Berhampur` : 'Brand Mark | Premium Fashion & Footwear Store in Berhampur';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ClothingStore',
  name: 'Brand Mark',
  alternateName: site.odia,
  description: site.description,
  url: site.url,
  telephone: '+917327820235',
  email: site.email,
  image: ogImage.href,
  logo: new URL('/brand/brandmark.svg', Astro.site).href,
  priceRange: '₹₹',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.line1,
    addressLocality: 'Berhampur',
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: site.hours.open,
      closes: site.hours.close,
    },
  ],
  sameAs: [site.instagram, 'https://mitty.co.in'],
  hasMap: site.mapsLink,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0d0c0b" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Brand Mark" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      (function () {
        var d = document.documentElement;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('motion');
        var seen, nav;
        try {
          seen = sessionStorage.getItem('bm-intro');
          nav = sessionStorage.getItem('bm-nav');
          sessionStorage.removeItem('bm-nav');
        } catch (e) {}
        if (nav) d.classList.add('curtain-on', 'curtain-nav');
        else if (!seen) d.classList.add('curtain-on');
        // Safety net: never leave content hidden if scripts fail.
        setTimeout(function () {
          if (!d.classList.contains('motion-ready')) d.classList.remove('motion', 'curtain-on', 'curtain-nav');
        }, 3500);
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Curtain />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
